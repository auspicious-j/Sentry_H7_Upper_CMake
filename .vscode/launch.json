{
    // [LINUX-PORT] 原为 cortex-debug + OpenOCD 烧录调试，现改为本机 gdb 调试
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Linux (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/sentry_upper_linux",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用 pretty-printer",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}